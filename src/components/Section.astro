---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Las coordenadas de los botones están en puntos del PDF original (ancho = 450).
interface Hotspot {
  href: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  external?: boolean;
  download?: boolean;
}

interface Props {
  id?: string;
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  hotspots?: Hotspot[];
}

const { id, src, alt, eager = false, hotspots = [] } = Astro.props;
const H = (450 * src.height) / src.width; // alto de la sección en puntos del PDF
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(4)}%`;
---

<section id={id} class="section">
  <Image
    src={src}
    alt={alt}
    widths={[480, 960, src.width]}
    sizes="(max-width: 480px) 100vw, 480px"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    quality={88}
  />
  {
    hotspots.map((h) => (
      <a
        class="hotspot"
        href={h.href}
        aria-label={h.label}
        target={h.external ? '_blank' : undefined}
        rel={h.external ? 'noopener' : undefined}
        download={h.download ? '' : undefined}
        style={`left:${pct(h.x, 450)};top:${pct(h.y, H)};width:${pct(h.w, 450)};height:${pct(h.h, H)}`}
      />
    ))
  }
</section>

<style>
  .section {
    position: relative;
    line-height: 0;
  }
  .section :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hotspot {
    position: absolute;
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s;
  }
  .hotspot:hover,
  .hotspot:focus-visible {
    background-color: rgb(255 255 255 / 0.12);
  }
  .hotspot:focus-visible {
    outline: 2px solid #8a9a82;
    outline-offset: 2px;
  }
</style>
