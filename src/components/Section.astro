---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Las coordenadas de los botones están en puntos del PDF original (ancho = 450).
interface Hotspot {
  href: string;
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
  external?: boolean;
  download?: boolean;
  latido?: boolean; // efecto heartbeat (por defecto activo)
}

interface Props {
  id?: string;
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  hotspots?: Hotspot[];
}

const { id, src, alt, eager = false, hotspots = [] } = Astro.props;
const H = (450 * src.height) / src.width; // alto de la sección en puntos del PDF
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(4)}%`;
---

<section id={id} class="section">
  <Image
    src={src}
    alt={alt}
    widths={[480, 960, src.width]}
    sizes="(max-width: 480px) 100vw, 480px"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    quality={88}
  />
  {
    hotspots.map((h) => (
      <a
        class="hotspot"
        href={h.href}
        aria-label={h.label}
        target={h.external ? '_blank' : undefined}
        rel={h.external ? 'noopener' : undefined}
        download={h.download ? '' : undefined}
        style={`left:${pct(h.x, 450)};top:${pct(h.y, H)};width:${pct(h.w, 450)};height:${pct(h.h, H)}`}
      >
        {h.latido !== false && (
          <span
            class="latido"
            aria-hidden="true"
            style={`background-size:${((450 / h.w) * 100).toFixed(4)}% auto;background-position:${pct(h.x, 450 - h.w)} ${pct(h.y, H - h.h)}`}
          />
        )}
      </a>
    ))
  }
  <slot />
</section>

<script>
  // El botón que late es una copia del mismo recorte de la imagen de la sección:
  // se usa la imagen que el navegador ya eligió (currentSrc), sin descargas extra.
  document.querySelectorAll<HTMLElement>('.section').forEach((sec) => {
    const img = sec.querySelector('img');
    if (!img || !sec.querySelector('.latido')) return;
    const usar = () => img.currentSrc && sec.style.setProperty('--img', `url("${img.currentSrc}")`);
    if (img.complete) usar();
    img.addEventListener('load', usar);
  });
</script>

<style>
  .section {
    position: relative;
    line-height: 0;
  }
  .section :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hotspot {
    position: absolute;
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s;
  }
  .hotspot:hover,
  .hotspot:focus-visible {
    background-color: rgb(255 255 255 / 0.12);
  }

  .latido {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-image: var(--img);
    background-repeat: no-repeat;
    transform-origin: center;
    animation: latido-boton 1.6s ease-in-out infinite;
    will-change: transform;
  }
  .hotspot:hover .latido,
  .hotspot:focus-visible .latido {
    filter: brightness(1.06);
  }
  /* Nombre propio: SobreAnimado ya define un @keyframes "latido" (global) para el sello */
  @keyframes latido-boton {
    0%,
    45%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.07);
    }
    22% {
      transform: scale(1.02);
    }
    32% {
      transform: scale(1.055);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .latido {
      animation: none;
    }
  }
  .hotspot:focus-visible {
    outline: 2px solid #8a9a82;
    outline-offset: 2px;
  }
</style>
